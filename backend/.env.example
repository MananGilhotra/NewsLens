# NewsLens backend configuration
# Copy this file to .env and fill in the values you have.
# Every key is optional in development - features fall back gracefully without them.

# Server port (the Vite dev server proxies /api to this port)
PORT=5001

# MongoDB - local default is mongodb://localhost:27017/newslens
# Needed for signup, login and analysis history.
MONGODB_URI=mongodb://localhost:27017/newslens

# Secret used to sign login tokens. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OpenRouter (https://openrouter.ai/keys) - enables LLM fact-checking, AI summaries and visual deepfake checks.
# Without it NewsLens uses its own trained model, extractive summaries and metadata forensics.
OPENROUTER_API_KEY=
# Optional model overrides (any OpenRouter model id)
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_VISION_MODEL=qwen/qwen3.8-27b
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# Groq (https://console.groq.com/keys) - fast LLMs with built-in web search and vision; free tier available.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Which LLM provider to try first (the other is the automatic fallback)
LLM_PROVIDER_ORDER=groq,openrouter
# Let AI fact-checks search the live web with cited sources (Groq browser search is included in its free tier;
# the OpenRouter web plugin costs ~$0.01-0.02 per check)
FACT_CHECK_WEB_SEARCH=true

# NewsAPI (https://newsapi.org/register) - optional; the feed uses public RSS feeds without it
# or when the free plan's daily limit is reached.
NEWS_API_KEY=
# Country used for NewsAPI top headlines (us, in, gb, ...)
NEWS_COUNTRY=us

# Google Fact Check Tools (https://developers.google.com/fact-check/tools/api) - optional, free.
# Adds published fact-checks (PolitiFact, Snopes, AFP...) to analyses.
GOOGLE_FACTCHECK_API_KEY=

# Public URL of the site, sent to OpenRouter as the referer
PUBLIC_SITE_URL=http://localhost:5173

# Set to production when deploying (serves the built frontend from ../frontend/dist)
NODE_ENV=development
